---
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getLanguageRoot,
} from '../data/routing';

interface Props {
  lang?: Language;
  title: string;
  description: string;
  canonical: URL;
  alternate: URL;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang = defaultLanguage,
  title,
  description,
  canonical,
  alternate,
  type = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const site = siteByLanguage[lang];
const copy = copyByLanguage[lang];
const alternateLanguage: Language = lang === 'es' ? 'en' : 'es';
const alternateSite = siteByLanguage[alternateLanguage];
const personId = new URL('/#person', canonical).toString();
const languageRoot = new URL(getLanguageRoot(lang), canonical);
const websiteId = new URL('#website', languageRoot).toString();
const socialImage = new URL('/social-card.png', canonical).toString();
const defaultUrl = lang === 'en' ? canonical : alternate;
const additionalGraph = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: new URL('/', canonical).toString(),
      jobTitle: site.title,
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        addressRegion: 'Mendoza',
        addressCountry: 'AR',
      },
      knowsLanguage: site.languages.map((language) => language.name),
      sameAs: site.sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: languageRoot.toString(),
      name: `${site.name} — ${copy.portfolioLabel}`,
      description: site.description,
      inLanguage: site.languageTag,
      about: { '@id': personId },
      publisher: { '@id': personId },
    },
    ...additionalGraph,
  ],
};
---

<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="theme-color" content={site.themeColor} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{
  !noindex && (
    <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang={site.languageTag} href={canonical} />
      <link rel="alternate" hreflang={alternateSite.languageTag} href={alternate} />
      <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    </>
  )
}

<meta property="og:locale" content={site.locale} />
<meta property="og:locale:alternate" content={site.alternateLocale} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={`${site.name} — ${copy.portfolioLabel}`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={copy.socialImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={copy.socialImageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

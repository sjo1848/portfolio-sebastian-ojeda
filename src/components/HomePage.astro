---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import {
  capabilityGroupsByLanguage,
  copyByLanguage,
  methodPhasesByLanguage,
  processStepsByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import { portfolioStoriesByLanguage } from '../data/portfolioStories';

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;

interface Props {
  lang: Language;
  primaryProjects: ProjectEntry[];
  secondaryProjects: ProjectEntry[];
}

const { lang, primaryProjects, secondaryProjects } = Astro.props;
const site = siteByLanguage[lang];
const copy = copyByLanguage[lang].home;
const storyCopy = portfolioStoriesByLanguage[lang];
const processSteps = processStepsByLanguage[lang];
const methodPhases = methodPhasesByLanguage[lang];
const capabilityGroups = capabilityGroupsByLanguage[lang];
---

<BaseLayout lang={lang}>
  <section class="hero section">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{site.title}</h1>
        <p class="hero-copy">{site.description}</p>
        <p class="hero-context">{copy.context}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">{copy.viewProjects}</a>
          <a class="button button-secondary" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <aside class="hero-proof" aria-label={copy.workflowAria}>
        {copy.workflow.map((step, index) => (
          <Fragment>
            <p>{step}</p>
            {index < copy.workflow.length - 1 && <span aria-hidden="true">→</span>}
          </Fragment>
        ))}
      </aside>
    </div>
  </section>

  <section id="projects" class="section section-surface" aria-labelledby="stories-title">
    <div class="container">
      <div class="section-heading projects-heading">
        <p class="eyebrow">{storyCopy.eyebrow}</p>
        <h2 id="stories-title">{storyCopy.title}</h2>
        <p>{storyCopy.intro}</p>
      </div>
      <div class="story-grid">
        {primaryProjects.map((project, index) => (
          <ProjectCard
            project={project}
            lang={lang}
            displayIndex={index + 1}
            variant={index === 0 ? 'hero' : 'story'}
          />
        ))}
      </div>

      <div class="secondary-heading">
        <p class="eyebrow">{storyCopy.secondaryEyebrow}</p>
        <h2>{storyCopy.secondaryTitle}</h2>
        <p>{storyCopy.secondaryIntro}</p>
      </div>
      <div class="secondary-grid">
        {secondaryProjects.map((project, index) => (
          <ProjectCard project={project} lang={lang} displayIndex={index + 5} variant="secondary" />
        ))}
      </div>
    </div>
  </section>

  <section id="capabilities" class="section section-night" aria-labelledby="capabilities-title">
    <div class="container split-grid">
      <div>
        <p class="eyebrow eyebrow-light">{copy.capabilitiesEyebrow}</p>
        <h2 id="capabilities-title">{copy.capabilitiesTitle}</h2>
      </div>
      <div class="capability-grid">
        {capabilityGroups.map((group) => (
          <article><h3>{group.title}</h3><p>{group.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container split-grid">
      <div class="section-heading">
        <p class="eyebrow">{copy.experienceEyebrow}</p>
        <h2 id="experience-title">{copy.experienceTitle}</h2>
      </div>
      <div class="reading-column">
        {copy.experienceParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section id="process" class="section section-surface" aria-labelledby="process-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{copy.processEyebrow}</p>
        <h2 id="process-title">{copy.processTitle}</h2>
        <p>{copy.processIntro}</p>
      </div>
      <ol class="method-flow" aria-label={copy.processTitle}>
        {methodPhases.map((phase, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{phase.name}</strong>
            <small>{phase.description}</small>
          </li>
        ))}
      </ol>
      <ol class="process-grid">
        {processSteps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container contact-panel">
      <div>
        <p class="eyebrow">{copy.contactEyebrow}</p>
        <h2 id="contact-title">{copy.contactTitle}</h2>
        <p>{site.location}. {site.workMode}</p>
        <p>{copy.englishLevel}</p>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>{copy.sendEmail}</a>
        <a class="button button-secondary" href={site.github} target="_blank" rel="noopener noreferrer">{copy.viewGithub}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #projects {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 92% 7%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 25rem),
      linear-gradient(180deg, var(--surface), color-mix(in srgb, var(--canvas) 55%, var(--surface)) 100%);
  }

  #projects .container {
    position: relative;
    z-index: 1;
  }

  .projects-heading {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .story-grid,
  .secondary-grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .secondary-heading {
    max-width: 52rem;
    margin-top: clamp(4.5rem, 8vw, 7rem);
    margin-bottom: 2rem;
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  .secondary-heading > p:last-child {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (min-width: 48rem) {
    .story-grid,
    .secondary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story-grid :global(.project-card-hero) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: center;
    }

    .story-grid :global(.project-card-hero .project-evidence) {
      width: auto;
      height: clamp(19rem, 31vw, 24rem);
      min-height: 0;
      margin: 1.25rem 0 1.25rem 1.25rem;
      border-radius: 1rem;
      aspect-ratio: auto;
    }

    .story-grid :global(.project-card-hero .project-body) {
      padding: clamp(1.75rem, 4vw, 2.5rem);
    }

    .story-grid :global(.project-card-story:last-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 68.75rem) {
    .story-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .story-grid :global(.project-card-hero) {
      grid-column: 1 / -1;
    }

    .story-grid :global(.project-card-story:last-child) {
      grid-column: auto;
    }
  }
</style>
---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SelectedWorkIndex from './SelectedWorkIndex.astro';
import CopyAction from './CopyAction';
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import { portfolioStoriesByLanguage } from '../data/portfolioStories';
import { humanStoryByLanguage } from '../data/humanStory';
import { getProjectPath } from '../data/routing';

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;

interface Props {
  lang: Language;
  primaryProjects: ProjectEntry[];
  secondaryProjects: ProjectEntry[];
}

const { lang, primaryProjects, secondaryProjects } = Astro.props;
const site = siteByLanguage[lang];
const copy = copyByLanguage[lang].home;
const storyCopy = portfolioStoriesByLanguage[lang];
const humanStory = humanStoryByLanguage[lang];
const mindset = portfolioStoriesByLanguage[lang].operatingMindset;
const brandHero = lang === 'es'
  ? {
      eyebrow: 'DESARROLLADOR FULL-STACK · FOCO BACKEND',
      thesis: 'Construyo los sistemas detrás del trabajo real.',
      thesisLines: ['CONSTRUYO LOS', 'SISTEMAS DETRÁS', 'DEL TRABAJO REAL.'],
      rotatingWords: ['SISTEMAS', 'SERVICIOS', 'PRODUCTOS'],
      thesisTail: 'DETRÁS',
      lead: 'Diseño y construyo software end-to-end para operaciones reales, conectando dominio, backend, datos, integraciones e interfaces en un sistema coherente.',
      location: 'Mendoza, Argentina · Remoto prioritario',
      workCta: 'Ver trabajo seleccionado',
  }
  : {
      eyebrow: 'FULL-STACK SOFTWARE DEVELOPER · BACKEND-FOCUSED',
      thesis: 'I build the systems behind real work.',
      thesisLines: ['I BUILD THE', 'SYSTEMS BEHIND', 'REAL WORK.'],
      rotatingWords: ['SYSTEMS', 'SERVICES', 'PRODUCTS'],
      thesisTail: 'BEHIND',
      lead: 'I design and build end-to-end software for real operations, connecting domain logic, backend, data, integrations and interfaces into one coherent system.',
      location: 'Mendoza, Argentina · Remote-first',
      workCta: 'View selected work',
    };
---

<BaseLayout lang={lang}>
  <section id="hero" class="hero hero-signature" aria-labelledby="hero-thesis">
    <div class="container hero-editorial-grid">
      <div class="hero-identity">
        <p class="eyebrow hero-role">{brandHero.eyebrow}</p>
        <p class="hero-location">{brandHero.location}</p>
      </div>
      <div class="hero-proposition">
        <h1 id="hero-thesis" class="hero-thesis" aria-label={brandHero.thesis}>
          {brandHero.thesisLines.map((line, index) => (
            <span class:list={['hero-thesis-line', { 'hero-thesis-final': index === 2 }]}>
              {index === 1 ? (
                <span class="hero-thesis-dynamic-line">
                  <span
                    class="hero-word-slot"
                    data-hero-word-slot
                    data-current-word={brandHero.rotatingWords[0]}
                    aria-hidden="true"
                  >
                    {brandHero.rotatingWords.map((word, wordIndex) => (
                      <span
                        class="hero-word"
                        data-hero-word
                        data-state={wordIndex === 0 ? 'active' : 'idle'}
                      >
                        {word}
                      </span>
                    ))}
                  </span>
                  <span class="hero-thesis-tail">{brandHero.thesisTail}</span>
                </span>
              ) : (
                <span data-text={index === 2 ? line : undefined}>{line}</span>
              )}
            </span>
          ))}
        </h1>
        <span class="hero-section-marker" aria-hidden="true"></span>
        <div class="hero-afterword">
          <p class="hero-copy">{brandHero.lead}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#projects">
              {brandHero.workCta}<span class="hero-cta-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="button button-secondary hero-resume-link" href={site.cv}>{copyByLanguage[lang].nav.cv}</a>
            <a class="hero-github-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="section section-surface" aria-labelledby="stories-title">
    <div class="container">
      <div class="section-heading projects-heading">
        <p class="eyebrow">{storyCopy.eyebrow}</p>
        <h2 id="stories-title">{storyCopy.title}</h2>
      </div>
      <SelectedWorkIndex lang={lang} projects={primaryProjects} />

    </div>
  </section>

  <section
    id="operating-mindset"
    class="section section-night"
    aria-labelledby="operating-mindset-title"
    data-operating-mindset
  >
    <div class="container">
      <div class="section-heading operating-mindset-heading">
        <p class="eyebrow eyebrow-light">{mindset.eyebrow}</p>
        <h2 id="operating-mindset-title" class="operating-mindset-title" aria-label={mindset.title}>
          {mindset.items.map((item, index) => (
            <>
              <a
                class="operating-mindset-trigger"
                href={`#operating-mindset-detail-${index + 1}`}
                data-mindset-trigger
                data-index={index}
                aria-controls={`operating-mindset-detail-${index + 1}`}
                aria-expanded={index === 0 ? 'true' : 'false'}
              >
                {item.title}.
              </a>
              {index < mindset.items.length - 1 && <span class="operating-mindset-separator" aria-hidden="true"> </span>}
            </>
          ))}
        </h2>
      </div>

      <ol class="operating-mindset-list" data-mindset-panels>
        {mindset.items.map((item, index) => (
          <li
            id={`operating-mindset-detail-${index + 1}`}
            data-mindset-panel
            data-state={index === 0 ? 'active' : 'idle'}
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <span class="operating-mindset-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="operating-mindset-context">
        <p class="operating-mindset-agentic">{mindset.agentic}</p>
        <p>{mindset.context}</p>
      </div>
    </div>
  </section>

  <section id="about" class="section human-story" aria-labelledby="about-title">
    <div class="container human-story-grid">
      <div class="human-story-heading">
        <h2 id="about-title">{humanStory.title}</h2>
      </div>
      <div class="human-story-content">
        <div class="human-story-copy">
          {humanStory.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section id="additional-work" class="section section-surface" aria-labelledby="additional-work-title">
    <div class="container">
      <div class="secondary-heading">
        <p class="eyebrow">{storyCopy.secondaryEyebrow}</p>
        <h2 id="additional-work-title">{storyCopy.secondaryTitle}</h2>
      </div>
      <ol class="additional-work-index" aria-labelledby="additional-work-title">
        {secondaryProjects.map((project, index) => (
          <li>
            <span class="additional-work-number">{String(index + 4).padStart(2, '0')}</span>
            <div class="additional-work-description">
              <a href={getProjectPath(lang, project.data.slug)}>{project.data.title}</a>
              <span>{project.data.category}</span>
            </div>
            <span class="additional-work-status">{project.data.statusLabel}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container contact-panel">
      <div>
        <p class="eyebrow">{copy.contactEyebrow}</p>
        <h2 id="contact-title">{copy.contactTitle}</h2>
        <p>{copy.contactBody}</p>
        <p>{copy.englishLevel}</p>
        <p class="contact-email-address">{site.email}</p>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>{copy.sendEmail}</a>
        <CopyAction
          client:idle
          email={site.email}
          label={copy.copyEmail}
          pendingLabel={copy.copyingEmail}
          copiedMessage={copy.emailCopied}
          errorMessage={copy.emailCopyError}
        />
        <a class="button button-secondary" href={site.cv}>{copy.downloadCv}</a>
        <a class="button button-secondary" href={site.github} target="_blank" rel="noopener noreferrer">{copy.viewGithub}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/hero-scroll';
  import '../scripts/operating-mindset';
</script>

<style>
  .operating-mindset-heading { max-width: 64rem; }
  #operating-mindset .operating-mindset-title {
    display: flex;
    max-width: 17ch;
    flex-wrap: wrap;
    gap: 0 .22em;
    align-items: baseline;
    text-wrap: wrap;
  }
  .operating-mindset-trigger {
    position: relative;
    display: inline;
    border-radius: .08em;
    color: var(--night-text);
    text-decoration: none;
    transition: color 180ms var(--motion-ease);
  }
  .operating-mindset-trigger::after {
    position: absolute;
    right: 0;
    bottom: -.08em;
    left: 0;
    height: .07em;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--copper-light);
    content: '';
    transition: transform 240ms var(--motion-ease);
  }
  .operating-mindset-trigger:hover,
  .operating-mindset-trigger:focus-visible,
  .operating-mindset-trigger[aria-expanded='true'] {
    color: var(--copper-light);
  }
  .operating-mindset-trigger:focus-visible {
    outline: 3px solid var(--copper-light);
    outline-offset: .12em;
  }
  .operating-mindset-trigger[aria-expanded='true']::after {
    transform: scaleX(1);
  }
  #operating-mindset .operating-mindset-list {
    display: grid;
    min-height: 9rem;
    margin: clamp(2rem, 4vw, 3.25rem) 0 0;
    list-style: none;
  }
  #operating-mindset .operating-mindset-list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--night-text) 25%, transparent);
    padding-top: 1.25rem;
  }
  #operating-mindset .operating-mindset-list > li > span {
    color: var(--copper-light);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: .75rem;
    font-weight: 750;
  }
  #operating-mindset .operating-mindset-list h3 {
    color: var(--night-text);
    font-size: 1rem;
    letter-spacing: .01em;
    text-transform: uppercase;
  }
  #operating-mindset .operating-mindset-list p {
    max-width: 52rem;
    margin-top: .55rem;
    color: #d9dedd;
    font-size: clamp(1.02rem, 1.4vw, 1.22rem);
    line-height: 1.65;
  }
  #operating-mindset[data-mindset-enhanced='true'] .operating-mindset-list > li {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(.55rem);
    transition:
      opacity 240ms var(--motion-ease),
      transform 320ms var(--motion-ease),
      visibility 0s linear 320ms;
  }
  #operating-mindset[data-mindset-enhanced='true'] .operating-mindset-list > li[data-state='active'] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }
  .operating-mindset-context {
    display: grid;
    gap: .75rem;
    max-width: 58rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid color-mix(in srgb, var(--night-text) 17%, transparent);
    padding-top: 1.25rem;
    color: var(--night-muted);
    line-height: 1.65;
  }
  .operating-mindset-agentic {
    color: var(--night-text);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
  }
  .additional-work-index { display: grid; grid-template-columns: minmax(0, 1fr); list-style: none; }
  .additional-work-index li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.35rem 0.8rem; align-items: baseline; border-top: 1px solid var(--line); padding: 1rem 0; }
  .additional-work-number { color: var(--accent-strong); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.74rem; font-weight: 750; }
  .additional-work-description { display: grid; gap: 0.25rem; }
  .additional-work-description a { width: fit-content; min-height: 2.75rem; display: inline-flex; align-items: center; font-weight: 750; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .additional-work-description > span { color: var(--muted); font-size: 0.82rem; }
  .additional-work-status { grid-column: 2; color: var(--muted); font-size: 0.76rem; }

  #projects {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 92% 7%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 25rem),
      linear-gradient(180deg, var(--surface), color-mix(in srgb, var(--canvas) 55%, var(--surface)) 100%);
  }

  #projects .container {
    position: relative;
    z-index: 1;
  }

  .projects-heading {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .secondary-heading {
    max-width: 52rem;
    margin-top: 0;
    margin-bottom: 2rem;
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .additional-work-index { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; }
  }

  @media (max-width: 47.99rem) {
    #operating-mindset .operating-mindset-title { max-width: 14ch; gap: .08em .18em; }
    #operating-mindset .operating-mindset-list { min-height: 12rem; }
    #operating-mindset .operating-mindset-list h3 { font-size: .82rem; }
    #operating-mindset .operating-mindset-list p { font-size: 1rem; }
    .operating-mindset-trigger { min-height: 44px; }

    .additional-work-index li { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .additional-work-status { grid-column: 2; text-align: left; }
  }

  @media (min-width: 68.75rem) {
    .additional-work-index { column-gap: 4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .operating-mindset-trigger,
    .operating-mindset-trigger::after,
    #operating-mindset[data-mindset-enhanced='true'] .operating-mindset-list > li {
      transition: none;
    }
  }
</style>

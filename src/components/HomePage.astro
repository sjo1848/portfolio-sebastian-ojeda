---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import CopyAction from './CopyAction';
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import { portfolioStoriesByLanguage } from '../data/portfolioStories';
import { humanStoryByLanguage } from '../data/humanStory';
import { getProjectPath } from '../data/routing';

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;

interface Props {
  lang: Language;
  primaryProjects: ProjectEntry[];
  secondaryProjects: ProjectEntry[];
}

const { lang, primaryProjects, secondaryProjects } = Astro.props;
const site = siteByLanguage[lang];
const copy = copyByLanguage[lang].home;
const storyCopy = portfolioStoriesByLanguage[lang];
const humanStory = humanStoryByLanguage[lang];
const mindset = portfolioStoriesByLanguage[lang].operatingMindset;
const brandHero = lang === 'es'
  ? {
      eyebrow: 'DESARROLLADOR DE SOFTWARE FULL-STACK · FOCO BACKEND',
      headline: ['FULL-STACK', 'SOFTWARE', 'DEVELOPER'],
      lead: 'Convierto procesos operativos en software confiable: backend, datos, integraciones e interfaces.',
      location: 'Mendoza, Argentina · Remoto prioritario',
      workCta: 'Ver trabajo seleccionado',
      resumeCta: 'Descargar CV',
    }
  : {
      eyebrow: 'FULL-STACK SOFTWARE DEVELOPER · BACKEND-ORIENTED',
      headline: ['FULL-STACK', 'SOFTWARE', 'DEVELOPER'],
      lead: 'I turn operational workflows into reliable software across backend, data, integrations and interfaces.',
      location: 'Mendoza, Argentina · Remote-first',
      workCta: 'View selected work',
      resumeCta: 'Download resume',
    };
---

<BaseLayout lang={lang}>
  <section id="hero" class="hero section">
    <div class="container hero-grid brand-hero-grid">
      <div class="brand-hero-copy">
        <p class="eyebrow">{brandHero.eyebrow}</p>
        <h1 class="brand-headline" data-motion-hero>
          {brandHero.headline.map((line, index) => <span class="hero-title-line" style={`--hero-line-index:${index}`}>
            <span class="hero-title-text">{line}</span>
          </span>)}
        </h1>
        <p class="hero-copy">{brandHero.lead}</p>
        <p class="hero-location">{brandHero.location}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">{brandHero.workCta}</a>
          <a class="button button-secondary" href={site.cv}>{brandHero.resumeCta}</a>
        </div>
        <a class="hero-github-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
  </section>

  <section id="projects" class="section section-surface" aria-labelledby="stories-title">
    <div class="container">
      <div class="section-heading projects-heading">
        <p class="eyebrow">{storyCopy.eyebrow}</p>
        <h2 id="stories-title">{storyCopy.title}</h2>
        <p>{storyCopy.intro}</p>
      </div>
      <div class="story-grid">
        {primaryProjects.map((project, index) => (
          <ProjectCard
            project={project}
            lang={lang}
            displayIndex={index + 1}
            variant={index === 0 ? 'hero' : 'story'}
          />
        ))}
      </div>

    </div>
  </section>

  <section id="operating-mindset" class="section section-night" aria-labelledby="operating-mindset-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow eyebrow-light">{mindset.eyebrow}</p>
        <h2 id="operating-mindset-title">{mindset.title}</h2>
      </div>
      <ol class="operating-mindset-list">
        {mindset.items.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{item.title}</h3><p>{item.description}</p></div>
          </li>
        ))}
      </ol>
      <p class="operating-mindset-context">{mindset.context}</p>
    </div>
  </section>

  <section id="about" class="section human-story" aria-labelledby="about-title">
    <div class="container human-story-grid">
      <div class="human-story-heading">
        <h2 id="about-title">{humanStory.title}</h2>
      </div>
      <div class="human-story-content">
        <div class="human-story-copy">
          {humanStory.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section id="additional-work" class="section section-surface" aria-labelledby="additional-work-title">
    <div class="container">
      <div class="secondary-heading">
        <p class="eyebrow">{storyCopy.secondaryEyebrow}</p>
        <h2 id="additional-work-title">{storyCopy.secondaryTitle}</h2>
      </div>
      <ol class="additional-work-index" aria-labelledby="additional-work-title">
        {secondaryProjects.map((project, index) => (
          <li>
            <span class="additional-work-number">{String(index + 4).padStart(2, '0')}</span>
            <div class="additional-work-description">
              <a href={getProjectPath(lang, project.data.slug)}>{project.data.title}</a>
              <span>{project.data.category}</span>
            </div>
            <span class="additional-work-status">{project.data.statusLabel}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container contact-panel">
      <div>
        <p class="eyebrow">{copy.contactEyebrow}</p>
        <h2 id="contact-title">{copy.contactTitle}</h2>
        <p>{copy.contactBody}</p>
        <p>{copy.englishLevel}</p>
        <p class="contact-email-address">{site.email}</p>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>{copy.sendEmail}</a>
        <CopyAction
          client:idle
          email={site.email}
          label={copy.copyEmail}
          pendingLabel={copy.copyingEmail}
          copiedMessage={copy.emailCopied}
          errorMessage={copy.emailCopyError}
        />
        <a class="button button-secondary" href={site.cv}>{copy.downloadCv}</a>
        <a class="button button-secondary" href={site.github} target="_blank" rel="noopener noreferrer">{copy.viewGithub}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-title-line { display: block; }
  .hero-location { margin-top: 0.9rem; color: var(--muted); font-size: 0.95rem; }
  .hero-github-link { display: inline-flex; min-height: 2.75rem; align-items: center; margin-top: 0.5rem; color: var(--muted); font-size: 0.9rem; }
  .operating-mindset-list { display: grid; gap: 1.5rem; margin: 2.5rem 0 0; list-style: none; }
  .operating-mindset-list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; border-top: 1px solid color-mix(in srgb, var(--night-text) 25%, transparent); padding-top: 1.25rem; }
  .operating-mindset-list > li > span { color: var(--copper-light); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.75rem; font-weight: 750; }
  .operating-mindset-list h3 { color: var(--night-text); font-size: 1.25rem; }
  .operating-mindset-list p, .operating-mindset-context { max-width: 48rem; margin-top: 0.75rem; color: #c9d0ce; line-height: 1.65; }
  .operating-mindset-context { margin-top: 2rem; }
  .additional-work-index { display: grid; grid-template-columns: minmax(0, 1fr); list-style: none; }
  .additional-work-index li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.35rem 0.8rem; align-items: baseline; border-top: 1px solid var(--line); padding: 1rem 0; }
  .additional-work-number { color: var(--accent-strong); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.74rem; font-weight: 750; }
  .additional-work-description { display: grid; gap: 0.25rem; }
  .additional-work-description a { width: fit-content; min-height: 2.75rem; display: inline-flex; align-items: center; font-weight: 750; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .additional-work-description > span { color: var(--muted); font-size: 0.82rem; }
  .additional-work-status { grid-column: 2; color: var(--muted); font-size: 0.76rem; }

  .brand-hero-grid { grid-template-columns: minmax(0, 1fr); }
  .brand-hero-copy { width: 100%; max-width: none; }

  #projects {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 92% 7%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 25rem),
      linear-gradient(180deg, var(--surface), color-mix(in srgb, var(--canvas) 55%, var(--surface)) 100%);
  }

  #projects .container {
    position: relative;
    z-index: 1;
  }

  .projects-heading {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .story-grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .secondary-heading {
    max-width: 52rem;
    margin-top: 0;
    margin-bottom: 2rem;
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .story-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .additional-work-index { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; }

    .story-grid :global(.project-card-hero) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: center;
    }

    .story-grid :global(.project-card-hero .project-evidence) {
      width: auto;
      height: clamp(19rem, 31vw, 24rem);
      min-height: 0;
      margin: 1.25rem 0 1.25rem 1.25rem;
      border-radius: 1rem;
      aspect-ratio: auto;
    }

    .story-grid :global(.project-card-hero .project-body) {
      padding: clamp(1.75rem, 4vw, 2.5rem);
    }

    .story-grid :global(.project-card-story:last-child) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .operating-mindset-list { grid-template-columns: minmax(0, 1fr); gap: 1.1rem; }
    .additional-work-index li { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .additional-work-status { grid-column: 2; text-align: left; }
  }

  @media (min-width: 68.75rem) {
    .story-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .story-grid :global(.project-card-hero) {
      grid-column: 1 / -1;
    }

    .story-grid :global(.project-card-story:last-child) {
      grid-column: auto;
    }
    .additional-work-index { column-gap: 4rem; }
  }
</style>

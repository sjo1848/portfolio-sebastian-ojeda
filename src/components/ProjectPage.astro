---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyQuickScan from './CaseStudyQuickScan.astro';
import EvidenceGallery from './EvidenceGallery';
import ResponsiveMediaViewer from './ResponsiveMediaViewer';
import CaseStudyContents from './CaseStudyContents';
import { getProjectMedia } from '../data/projectMedia';
import { getProjectQuickScan } from '../data/projectQuickScans';
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import {
  getLanguageRoot,
  getProjectPath,
} from '../data/routing';

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;

interface Props {
  project: ProjectEntry;
  lang: Language;
}

const { project, lang } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;
const quickScanTarget = headings[0]?.slug
  ? `#${headings[0].slug}`
  : `#project-content-${data.slug}`;
const media = getProjectMedia(data.slug);
const cover = media?.cover ?? null;
const gallery = media?.gallery ?? [];
const quickScan = getProjectQuickScan(data.slug, lang);
const copy = copyByLanguage[lang].project;
const site = siteByLanguage[lang];
const galleryRootId = `gallery-items-${data.slug}`;
const gallerySectionId = `gallery-${data.slug}`;
const galleryTitle = lang === 'es' ? 'Capturas y recorridos verificados' : 'Verified screenshots and walkthroughs';
const contentsItems = [
  ...(gallery.length > 0
    ? [{
        id: gallerySectionId,
        text: galleryTitle,
        depth: 2,
        kind: 'section' as const,
      }]
    : []),
  ...headings.map(({ slug, text, depth }) => ({ id: slug, text, depth, kind: 'markdown' as const })),
];
const galleryItems = gallery.map((asset) => ({
  kind: asset.kind,
  src: asset.src,
  alt: asset.alt[lang],
  caption: asset.caption[lang],
  width: asset.width,
  height: asset.height,
}));
const galleryCopy = lang === 'es'
  ? {
      eyebrow: 'Evidencia visual',
      title: galleryTitle,
      description: 'Imágenes y demostraciones animadas reales del producto documentadas como evidencia del flujo y de las decisiones de interfaz.',
      openImage: 'Abrir captura a tamaño completo',
      playGif: 'Reproducir GIF',
      stopGif: 'Detener GIF',
      openGif: 'Abrir GIF completo',
      gifReady: 'Demostración animada disponible',
      gifAvailable: 'GIF disponible',
      gifError: 'No se pudo reproducir esta demostración. Podés abrir el GIF original.',
      previous: 'Evidencia anterior',
      next: 'Evidencia siguiente',
      galleryName: 'Galería de evidencia visual',
      carouselName: 'Carrusel de evidencia visual',
    }
  : {
      eyebrow: 'Visual evidence',
      title: galleryTitle,
      description: 'Real product images and animated demonstrations documented as evidence of the workflow and interface decisions.',
      openImage: 'Open full-size screenshot',
      playGif: 'Play GIF',
      stopGif: 'Stop GIF',
      openGif: 'Open full GIF',
      gifReady: 'Animated demonstration available',
      gifAvailable: 'GIF available',
      gifError: 'This demonstration could not be played. You can open the original GIF.',
      previous: 'Previous evidence',
      next: 'Next evidence',
      galleryName: 'Visual evidence gallery',
      carouselName: 'Visual evidence carousel',
    };
const projectUrl = new URL(getProjectPath(lang, data.slug), Astro.site ?? Astro.url);
const projectSchema = {
  '@type': 'SoftwareSourceCode',
  '@id': `${projectUrl.toString()}#software`,
  name: data.title,
  description: data.summary,
  url: projectUrl.toString(),
  codeRepository: data.repository ?? undefined,
  programmingLanguage: data.stack,
  inLanguage: site.languageTag,
  image: cover ? new URL(cover.src, projectUrl).toString() : undefined,
  author: { '@id': new URL('/#person', projectUrl).toString() },
};
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.summary}
  ogType="article"
  structuredData={projectSchema}
>
  <article class="case-study">
    <header class="case-hero section section-surface">
      <div class="container case-hero-grid">
        <div>
          <p class="eyebrow">{data.category}</p>
          <h1>{data.title}</h1>
          <p class="hero-copy">{data.summary}</p>
          <dl class="project-meta">
            <div><dt>{copy.state}</dt><dd>{data.statusLabel}</dd></div>
            <div><dt>{copy.role}</dt><dd>{data.role}</dd></div>
            <div><dt>{copy.year}</dt><dd>{data.year}</dd></div>
          </dl>
          <div class="hero-actions">
            {data.repository && (
              <a class="button button-primary" href={data.repository} target="_blank" rel="noopener noreferrer">{copy.viewCode}</a>
            )}
            <a class="button button-secondary" href={`${getLanguageRoot(lang)}#projects`}>{copy.backToProjects}</a>
          </div>
        </div>
        <aside class:list={['case-evidence', { 'case-evidence-with-media': cover }]}>
          {
            cover && (
              <figure class="case-media">
                <img
                  src={cover.src}
                  alt={cover.alt[lang]}
                  width={cover.width}
                  height={cover.height}
                  decoding="async"
                />
                <figcaption>{cover.caption[lang]}</figcaption>
              </figure>
            )
          }
          <p class="eyebrow">{copy.mainStack}</p>
          <ul class="stack-list stack-list-large">
            {data.stack.map((technology) => <li>{technology}</li>)}
          </ul>
          {!cover && <p class="evidence-note">{copy.pendingEvidence}</p>}
        </aside>
      </div>
    </header>
    {
      quickScan && (
        <CaseStudyQuickScan
          id={`case-quick-scan-${data.slug}`}
          copy={quickScan}
          repository={data.repository}
          demo={data.demo}
          caseStudyTarget={quickScanTarget}
        />
      )
    }
    {
      gallery.length > 0 && (
        <section
          id={gallerySectionId}
          class="project-gallery section"
          aria-labelledby={`gallery-title-${data.slug}`}
        >
          <div class="container">
            <div class="section-heading">
              <p class="eyebrow">{galleryCopy.eyebrow}</p>
              <h2 id={`gallery-title-${data.slug}`}>{galleryCopy.title}</h2>
              <p>{galleryCopy.description}</p>
            </div>
            <EvidenceGallery
              client:visible
              rootId={galleryRootId}
              title={data.title}
              lang={lang}
              items={galleryItems}
              labels={galleryCopy}
            />
          </div>
        </section>
      )
    }
    <div class:list={['container', 'content-layout', { 'content-layout-with-contents': contentsItems.length > 0 }]}>
      {contentsItems.length > 0 && (
        <CaseStudyContents
          client:idle
          lang={lang}
          title={lang === 'es' ? 'Contenido del caso' : 'Case study contents'}
          triggerLabel={lang === 'es' ? 'Contenido' : 'Contents'}
          items={contentsItems}
        />
      )}
      <div class="prose" id={`project-content-${data.slug}`}>
        {data.slug === 'hms-cloudflare' && (
          <div class="media-viewer-island" aria-hidden="true">
            <ResponsiveMediaViewer
              client:visible
              rootId={`project-content-${data.slug}`}
              title={data.title}
              lang={lang}
            />
          </div>
        )}
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const stabilizeGalleryAnchor = () => {
    const hash = window.location.hash;
    if (!hash.startsWith('#gallery-')) return;

    const target = document.getElementById(decodeURIComponent(hash.slice(1)));
    if (!target) return;

    requestAnimationFrame(() => {
      target.scrollIntoView({ block: 'start' });
    });
  };

  if (document.readyState === 'complete') {
    stabilizeGalleryAnchor();
  } else {
    window.addEventListener('load', stabilizeGalleryAnchor, { once: true });
  }
  window.addEventListener('hashchange', stabilizeGalleryAnchor);

</script>

<style>
  .project-gallery {
    scroll-margin-top: 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--canvas);
  }

  .prose :global(.media-viewer-trigger) {
    display: block;
    width: fit-content;
    max-width: 100%;
    border-radius: var(--radius-card);
  }

  .prose :global(.media-viewer-trigger img) {
    display: block;
    height: auto;
  }

</style>

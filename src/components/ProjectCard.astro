---
import type { CollectionEntry } from 'astro:content';
import { getHomepageProjectCover, getHomepageProjectMedia } from '../data/homepageProjectCovers';
import { getProjectMedia } from '../data/projectMedia';
import { getProofActionLabel, getProjectProof } from '../data/projectProofs';
import {
  copyByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getProjectPath,
} from '../data/routing';

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;

type CardVariant = 'default' | 'hero' | 'story' | 'secondary';

interface Props {
  project: ProjectEntry;
  lang?: Language;
  displayIndex?: number;
  variant?: CardVariant;
}

const {
  project,
  lang = defaultLanguage,
  displayIndex,
  variant = 'default',
} = Astro.props;
const { data } = project;
const media = getProjectMedia(data.slug);
const proof = getProjectProof(data.slug);
const homepageMedia = getHomepageProjectMedia(data.slug);
const selectedCardMedia = data.slug === 'hms-cloudflare' && variant === 'hero'
  ? homepageMedia?.gallery[0]
  : null;
const cover = selectedCardMedia ?? getHomepageProjectCover(data.slug) ?? media?.cover ?? null;
const coverIsPortrait = cover ? cover.height > cover.width * 1.15 : false;
const copy = copyByLanguage[lang].project;
const indexLabel = String(displayIndex ?? data.order).padStart(2, '0');
const projectPath = getProjectPath(lang, data.slug);
const proofHref = proof?.proofHref?.[lang] ?? null;
const ctaHref = proofHref ? `${projectPath}${proofHref}` : projectPath;
const ctaLabel = proofHref && proof
  ? getProofActionLabel(proof.currentProofMode, lang)
  : copy.viewCaseStudy;
const labels = lang === 'es'
  ? {
      role: 'Rol',
      stack: 'Stack',
    }
  : {
      role: 'Role',
      stack: 'Stack',
    };
const visibleStack = data.stack.slice(0, variant === 'hero' ? 4 : 3);
---

<article class:list={['project-card', `project-card-${variant}`, cover && 'project-card-has-evidence']}>
  {
    cover ? (
      <figure
        class:list={[
          'project-evidence',
          'project-evidence-image',
          coverIsPortrait && 'project-evidence-portrait',
        ]}
      >
        <a
          class="project-evidence-link"
          href={projectPath}
          aria-label={`${copy.viewCaseStudy}: ${data.title} — ${cover.alt[lang]}`}
        >
          <div class="project-shot">
            <img
              src={cover.src}
              alt={cover.alt[lang]}
              width={cover.width}
              height={cover.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
        <figcaption>
          <span>{indexLabel}</span>
          <strong>{data.category}</strong>
          {selectedCardMedia && <small>{selectedCardMedia.caption[lang]}</small>}
        </figcaption>
      </figure>
    ) : (
      <div class="project-evidence project-evidence-placeholder" aria-hidden="true">
        <span>{indexLabel}</span>
        <strong>{data.category}</strong>
      </div>
    )
  }

  <div class="project-body">
    <p class="project-status">{data.statusLabel}</p>
    <h3><a class="project-title-link" href={projectPath}>{data.title}</a></h3>
    <p class="project-context">{data.summary}</p>

    <div class="project-proof">
      <p class="project-role">
        <span>{labels.role}</span>
        <strong>{data.role}</strong>
      </p>
      <p class="project-tech" aria-label={`${labels.stack}: ${visibleStack.join(', ')}`}>
        {visibleStack.join(' · ')}
      </p>
    </div>

    <a class="project-case-link button button-secondary" href={ctaHref}>
      <span>{ctaLabel}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .project-body {
    display: flex;
    min-height: 100%;
    flex-direction: column;
  }

  .project-status {
    width: fit-content;
    margin-bottom: 0.85rem;
    color: var(--accent-strong);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .project-context {
    margin-top: 1rem;
    color: var(--muted);
    line-height: 1.62;
  }

  .project-evidence-link,
  .project-title-link {
    color: inherit;
    text-decoration: none;
  }

  .project-evidence-link {
    display: block;
  }

  .project-title-link:hover {
    color: var(--accent-strong);
  }

  .project-proof {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .project-role {
    display: grid;
    gap: 0.25rem;
  }

  .project-role span {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .project-role strong {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 680;
    line-height: 1.45;
  }

  .project-tech {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.74rem;
    line-height: 1.55;
  }

  .project-case-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.65rem;
    margin-top: auto;
    color: var(--ink);
    font-weight: 780;
    padding: 0.7rem 1rem;
  }

  .project-case-link > span:last-child {
    color: var(--accent);
    font-size: 1.1rem;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .project-case-link:hover {
    color: var(--ink);
  }

  .project-case-link:hover > span:last-child,
  .project-case-link:focus-visible > span:last-child {
    transform: translateX(0.2rem);
  }

  .project-card-secondary .project-context {
    font-size: 0.95rem;
  }

  @media (min-width: 48rem) {
    .project-card-hero .project-proof {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: end;
      column-gap: 1.5rem;
    }

    .project-card-hero .project-tech {
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-case-link > span:last-child {
      transition: none;
    }
  }
</style>

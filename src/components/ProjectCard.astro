---
import type { CollectionEntry } from 'astro:content';
import { getProjectMedia } from '../data/projectMedia';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const media = getProjectMedia(data.slug);
---

<article class="project-card">
  {
    media ? (
      <figure class="project-evidence project-evidence-image">
        <img
          src={media.src}
          alt={media.alt}
          width={media.width}
          height={media.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span>{String(data.order).padStart(2, '0')}</span>
          <strong>{data.category}</strong>
        </figcaption>
      </figure>
    ) : (
      <div class="project-evidence" aria-hidden="true">
        <span>{String(data.order).padStart(2, '0')}</span>
        <strong>{data.category}</strong>
      </div>
    )
  }
  <div class="project-body">
    <p class="eyebrow">{data.statusLabel}</p>
    <h3>{data.title}</h3>
    <p>{data.summary}</p>
    <ul class="stack-list" aria-label={`Tecnologías de ${data.title}`}>
      {data.stack.slice(0, 5).map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="card-actions">
      <a class="button button-primary" href={`/projects/${data.slug}/`}>Ver caso de estudio</a>
      <a class="text-link" href={data.repository} target="_blank" rel="noopener noreferrer">Ver código</a>
    </div>
  </div>
</article>

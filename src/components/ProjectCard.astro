---
import type { CollectionEntry } from 'astro:content';
import { getHomepageProjectCover } from '../data/homepageProjectCovers';
import { getProjectMedia } from '../data/projectMedia';
import {
  copyByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getProjectPath,
} from '../data/routing';

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;

type CardVariant = 'default' | 'hero' | 'story' | 'secondary';

interface Props {
  project: ProjectEntry;
  lang?: Language;
  displayIndex?: number;
  variant?: CardVariant;
}

const {
  project,
  lang = defaultLanguage,
  displayIndex,
  variant = 'default',
} = Astro.props;
const { data } = project;
const media = getProjectMedia(data.slug);
const cover = getHomepageProjectCover(data.slug) ?? media?.cover ?? null;
const coverIsPortrait = cover ? cover.height > cover.width * 1.15 : false;
const copy = copyByLanguage[lang].project;
const indexLabel = String(displayIndex ?? data.order).padStart(2, '0');
const labels = lang === 'es'
  ? {
      role: 'Rol',
      evidence: 'Evidencia',
      documented: 'Caso documentado',
      visual: 'Capturas',
      code: 'Código',
      demo: 'Demo',
    }
  : {
      role: 'Role',
      evidence: 'Evidence',
      documented: 'Documented case',
      visual: 'Screenshots',
      code: 'Code',
      demo: 'Demo',
    };
const evidenceSignals = [
  labels.documented,
  cover ? labels.visual : null,
  data.repository ? labels.code : null,
  data.demo ? labels.demo : null,
].filter((signal): signal is string => Boolean(signal));
---

<article class:list={['project-card', `project-card-${variant}`, cover && 'project-card-has-evidence']}>
  {
    cover ? (
      <figure
        class:list={[
          'project-evidence',
          'project-evidence-image',
          coverIsPortrait && 'project-evidence-portrait',
        ]}
      >
        <div class="project-shot">
          <img
            src={cover.src}
            alt={cover.alt[lang]}
            width={cover.width}
            height={cover.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <span>{indexLabel}</span>
          <strong>{data.category}</strong>
        </figcaption>
      </figure>
    ) : (
      <div class="project-evidence project-evidence-placeholder" aria-hidden="true">
        <span>{indexLabel}</span>
        <strong>{data.category}</strong>
      </div>
    )
  }
  <div class="project-body">
    <p class="eyebrow project-status">{data.statusLabel}</p>
    <h3>{data.title}</h3>
    <p class="project-context">{data.summary}</p>

    <p class="project-role">
      <span>{labels.role}</span>
      <strong>{data.role}</strong>
    </p>

    <p class="project-proof">
      <span>{labels.evidence}</span>
      <strong>{evidenceSignals.join(' · ')}</strong>
    </p>

    <ul class="project-stack-inline" aria-label={`${copy.technologiesAria} ${data.title}`}>
      {data.stack.slice(0, 4).map((technology) => <li>{technology}</li>)}
    </ul>

    <div class="card-actions">
      <a class="button button-primary" href={getProjectPath(lang, data.slug)}>{copy.viewCaseStudy}</a>
      {data.repository && (
        <a class="text-link" href={data.repository} target="_blank" rel="noopener noreferrer">{copy.viewCode}</a>
      )}
    </div>
  </div>
</article>

<style>
  .project-status {
    width: fit-content;
    margin-bottom: 0.85rem;
  }

  .project-context {
    margin-top: 1rem;
    color: var(--muted);
  }

  .project-role,
  .project-proof {
    display: grid;
    grid-template-columns: minmax(4.5rem, auto) 1fr;
    gap: 0.8rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .project-proof {
    margin-top: 0.8rem;
    padding-top: 0;
    border-top: 0;
  }

  .project-role > span,
  .project-proof > span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .project-role strong,
  .project-proof strong {
    font-weight: 650;
  }

  .project-proof strong {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .project-stack-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.55rem;
    margin-top: 1.2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.73rem;
    list-style: none;
  }

  .project-stack-inline li + li::before {
    margin-right: 0.55rem;
    color: var(--accent);
    content: '·';
  }

  .card-actions {
    margin-top: 1.5rem;
  }

  @media (max-width: 31rem) {
    .project-role,
    .project-proof {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
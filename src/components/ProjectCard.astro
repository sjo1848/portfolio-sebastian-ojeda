---
import type { CollectionEntry } from 'astro:content';
import { getHomepageProjectCover } from '../data/homepageProjectCovers';
import { getProjectMedia } from '../data/projectMedia';
import {
  copyByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getProjectPath,
} from '../data/routing';

type ProjectEntry = CollectionEntry<'projects'> | CollectionEntry<'projectsEn'>;

type CardVariant = 'default' | 'hero' | 'story' | 'secondary';

interface Props {
  project: ProjectEntry;
  lang?: Language;
  displayIndex?: number;
  variant?: CardVariant;
}

const {
  project,
  lang = defaultLanguage,
  displayIndex,
  variant = 'default',
} = Astro.props;
const { data } = project;
const media = getProjectMedia(data.slug);
const cover = getHomepageProjectCover(data.slug) ?? media?.cover ?? null;
const coverIsPortrait = cover ? cover.height > cover.width * 1.15 : false;
const copy = copyByLanguage[lang].project;
const indexLabel = String(displayIndex ?? data.order).padStart(2, '0');
const labels = lang === 'es'
  ? {
      role: 'Rol',
      evidence: 'Evidencia',
      documented: 'Caso documentado',
      visual: 'Evidencia visual',
      code: 'Código disponible',
      demo: 'Demo disponible',
      stack: 'Stack principal',
    }
  : {
      role: 'Role',
      evidence: 'Evidence',
      documented: 'Documented case study',
      visual: 'Visual evidence',
      code: 'Code available',
      demo: 'Demo available',
      stack: 'Core stack',
    };
const evidenceSignals = [
  labels.documented,
  cover ? labels.visual : null,
  data.repository ? labels.code : null,
  data.demo ? labels.demo : null,
].filter((signal): signal is string => Boolean(signal));
---

<article class:list={['project-card', `project-card-${variant}`, cover && 'project-card-has-evidence']}>
  {
    cover ? (
      <figure
        class:list={[
          'project-evidence',
          'project-evidence-image',
          coverIsPortrait && 'project-evidence-portrait',
        ]}
      >
        <div class="project-shot">
          <img
            src={cover.src}
            alt={cover.alt[lang]}
            width={cover.width}
            height={cover.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <span>{indexLabel}</span>
          <strong>{data.category}</strong>
        </figcaption>
      </figure>
    ) : (
      <div class="project-evidence project-evidence-placeholder" aria-hidden="true">
        <span>{indexLabel}</span>
        <strong>{data.category}</strong>
      </div>
    )
  }
  <div class="project-body">
    <p class="eyebrow project-status">{data.statusLabel}</p>
    <h3>{data.title}</h3>
    <p class="project-context">{data.summary}</p>

    <dl class="project-card-meta">
      <div>
        <dt>{labels.role}</dt>
        <dd>{data.role}</dd>
      </div>
      <div>
        <dt>{labels.evidence}</dt>
        <dd class="project-signal-list">
          {evidenceSignals.map((signal) => <span>{signal}</span>)}
        </dd>
      </div>
    </dl>

    <div class="project-stack">
      <p>{labels.stack}</p>
      <ul class="stack-list" aria-label={`${copy.technologiesAria} ${data.title}`}>
        {data.stack.slice(0, 4).map((technology) => <li>{technology}</li>)}
      </ul>
    </div>

    <div class="card-actions">
      <a class="button button-primary" href={getProjectPath(lang, data.slug)}>{copy.viewCaseStudy}</a>
      {data.repository && (
        <a class="text-link" href={data.repository} target="_blank" rel="noopener noreferrer">{copy.viewCode}</a>
      )}
    </div>
  </div>
</article>

<style>
  .project-status {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--line));
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }

  .project-context {
    margin-top: 1rem;
    color: var(--muted);
  }

  .project-card-meta {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .project-card-meta div {
    display: grid;
    gap: 0.35rem;
  }

  .project-card-meta dt,
  .project-stack > p {
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .project-card-meta dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .project-signal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-signal-list span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.24rem 0.55rem;
    background: color-mix(in srgb, var(--surface) 86%, var(--canvas));
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .project-stack {
    margin-top: 1.4rem;
  }

  .project-stack :global(.stack-list) {
    margin-top: 0.65rem;
  }

  @media (min-width: 48rem) {
    .project-card-hero .project-card-meta {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    }
  }
</style>
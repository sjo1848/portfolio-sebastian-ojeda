---
interface Props {
  href: string;
  label: string;
  rel?: string;
  target?: string;
  class?: string;
}

const {
  href,
  label,
  rel = 'me noopener noreferrer',
  target = '_blank',
  class: className,
} = Astro.props;
---

<a
  class:list={['github-mark-link', className]}
  href={href}
  target={target}
  rel={rel}
  aria-label={label}
  title={label}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12 .7a11.3 11.3 0 0 0-3.57 22.03c.57.1.78-.25.78-.55v-2.15c-3.34.74-4.04-1.64-4.04-1.64-.55-1.42-1.34-1.8-1.34-1.8-1.09-.76.08-.75.08-.75 1.2.09 1.84 1.25 1.84 1.25 1.07 1.85 2.8 1.32 3.48 1.01.11-.79.42-1.32.76-1.63-2.67-.31-5.47-1.36-5.47-5.97 0-1.32.46-2.4 1.23-3.25-.12-.31-.53-1.56.12-3.2 0 0 1-.33 3.38 1.24a11.5 11.5 0 0 1 6.15 0c2.57-1.57 3.38-1.24 3.38-1.24.65 1.64.24 2.89.12 3.2.77.85 1.23 1.93 1.23 3.25 0 4.62-2.81 5.66-5.49 5.96.43.38.81 1.11.81 2.24v3.32c0 .31.21.66.82.55A11.3 11.3 0 0 0 12 .7Z"
    />
  </svg>
</a>

<style>
  .github-mark-link {
    display: inline-flex;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    flex: 0 0 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--line) 88%, var(--ink));
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform var(--motion-fast) var(--motion-ease),
      border-color var(--motion-fast) var(--motion-ease),
      background-color var(--motion-fast) var(--motion-ease),
      color var(--motion-fast) var(--motion-ease);
  }

  .github-mark-link svg {
    inline-size: 1.28rem;
    block-size: 1.28rem;
  }

  .github-mark-link:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    background: var(--paper);
    color: var(--accent-strong);
  }

  .github-mark-link:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .github-mark-link {
      transition: none;
    }

    .github-mark-link:hover {
      transform: none;
    }
  }
</style>

---
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getAlternatePath,
  getLanguageRoot,
} from '../data/routing';
import MobileNavigation from './MobileNavigation';

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;
const site = siteByLanguage[lang];
const copy = copyByLanguage[lang];
const root = getLanguageRoot(lang);
const alternateLanguage = lang === 'es' ? 'en' : 'es';
const alternatePath = getAlternatePath(Astro.url.pathname, lang);
const aboutLabel = lang === 'es' ? 'Sobre mí' : 'About';
const capabilitiesLabel = lang === 'es' ? 'Capacidades' : 'Capabilities';
const navigationItems = [
  { label: copy.nav.projects, href: `${root}#projects` },
  { label: aboutLabel, href: `${root}#about` },
  { label: capabilitiesLabel, href: `${root}#capabilities` },
  { label: copy.nav.experience, href: `${root}#experience` },
  { label: copy.nav.process, href: `${root}#process` },
  { label: copy.nav.contact, href: `${root}#contact` },
];
---

<header class="site-header">
  <div class="container header-inner brand-header-inner">
    <a class="brand" href={root} aria-label={site.name}>{site.name}</a>
    <div class="header-actions">
      <nav class="desktop-navigation" aria-label={copy.navigationLabel}>
        <ul class="nav-list">
          {navigationItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <a
        class="language-link"
        href={alternatePath}
        hreflang={alternateLanguage}
        lang={alternateLanguage}
        aria-label={copy.languageSwitchAria}
      >
        {copy.languageSwitch}
      </a>
      <div class="mobile-navigation-slot">
        <MobileNavigation
          client:load
          brandName={site.name}
          lang={lang}
          navigationLabel={copy.navigationLabel}
          items={navigationItems}
          languageHref={alternatePath}
          languageLabel={copy.languageSwitchAria}
          languageCode={copy.languageSwitch}
        />
      </div>
    </div>
  </div>
</header>

<style>
  .brand {
    min-inline-size: 9.5rem;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
  }

  .mobile-navigation-slot {
    display: none;
  }

  .language-link {
    display: inline-flex;
    min-width: 2.8rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding-inline: 0.65rem;
    background: color-mix(in srgb, var(--surface) 76%, transparent);
    color: var(--accent-strong);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  @media (max-width: 47.99rem) {
    .brand-header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 0.75rem;
      padding-block: 0.55rem;
    }

    .header-actions {
      display: contents;
    }

    .desktop-navigation {
      display: none;
    }

    .mobile-navigation-slot {
      display: block;
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .language-link {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      display: none;
    }
  }
</style>

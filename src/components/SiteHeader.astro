---
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getAlternatePath,
  getLanguageRoot,
} from '../data/routing';

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;
const site = siteByLanguage[lang];
const copy = copyByLanguage[lang];
const root = getLanguageRoot(lang);
const alternateLanguage = lang === 'es' ? 'en' : 'es';
const alternatePath = getAlternatePath(Astro.url.pathname, lang);
const brandInitial = site.name.slice(0, 1);
const brandRest = site.name.slice(1);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand brand-reveal" href={root} aria-label={site.name}>
      <span class="brand-initial" aria-hidden="true">{brandInitial}</span>
      <span class="brand-rest" aria-hidden="true">{brandRest}</span>
    </a>
    <nav aria-label={copy.navigationLabel}>
      <ul class="nav-list">
        <li><a href={`${root}#projects`}>{copy.nav.projects}</a></li>
        <li><a href={`${root}#process`}>{copy.nav.process}</a></li>
        <li><a href={`${root}#experience`}>{copy.nav.experience}</a></li>
        <li><a href={`${root}#contact`}>{copy.nav.contact}</a></li>
        <li><a href={site.cv} download>{copy.nav.cv}</a></li>
        <li>
          <a
            class="language-link"
            href={alternatePath}
            hreflang={alternateLanguage}
            lang={alternateLanguage}
            aria-label={copy.languageSwitchAria}
          >
            {copy.languageSwitch}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .brand-reveal {
    min-inline-size: 9.5rem;
    white-space: nowrap;
  }

  .brand-initial,
  .brand-rest {
    display: inline-block;
  }

  .brand-initial {
    transform-origin: left center;
    animation: brand-initial-arrive 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .brand-rest {
    overflow: hidden;
    max-inline-size: 0;
    opacity: 0;
    transform: translateX(-0.35rem);
    vertical-align: bottom;
    animation: brand-name-unfold 720ms cubic-bezier(0.22, 1, 0.36, 1) 180ms forwards;
  }

  @keyframes brand-initial-arrive {
    from {
      opacity: 0;
      transform: translateY(0.2rem) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes brand-name-unfold {
    0% {
      max-inline-size: 0;
      opacity: 0;
      transform: translateX(-0.35rem);
    }
    35% {
      opacity: 1;
    }
    100% {
      max-inline-size: 12rem;
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-initial,
    .brand-rest {
      animation: none;
      transform: none;
    }

    .brand-rest {
      max-inline-size: none;
      opacity: 1;
    }
  }
</style>

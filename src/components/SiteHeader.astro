---
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getAlternatePath,
  getLanguageRoot,
} from '../data/routing';

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;
const site = siteByLanguage[lang];
const copy = copyByLanguage[lang];
const root = getLanguageRoot(lang);
const alternateLanguage = lang === 'es' ? 'en' : 'es';
const alternatePath = getAlternatePath(Astro.url.pathname, lang);
const aboutLabel = lang === 'es' ? 'Sobre mí' : 'About';
const capabilitiesLabel = lang === 'es' ? 'Capacidades' : 'Capabilities';
---

<header class="site-header">
  <div class="container header-inner brand-header-inner">
    <a class="brand" href={root} aria-label={site.name}>{site.name}</a>
    <div class="header-actions">
      <nav aria-label={copy.navigationLabel}>
        <ul class="nav-list">
          <li><a href={`${root}#projects`}>{copy.nav.projects}</a></li>
          <li><a href={`${root}#about`}>{aboutLabel}</a></li>
          <li><a href={`${root}#capabilities`}>{capabilitiesLabel}</a></li>
          <li><a href={`${root}#experience`}>{copy.nav.experience}</a></li>
          <li><a href={`${root}#process`}>{copy.nav.process}</a></li>
          <li><a href={`${root}#contact`}>{copy.nav.contact}</a></li>
        </ul>
      </nav>
      <a
        class="language-link"
        href={alternatePath}
        hreflang={alternateLanguage}
        lang={alternateLanguage}
        aria-label={copy.languageSwitchAria}
      >
        {copy.languageSwitch}
      </a>
    </div>
  </div>
</header>

<style>
  .brand {
    min-inline-size: 9.5rem;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
  }

  .language-link {
    display: inline-flex;
    min-width: 2.8rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding-inline: 0.65rem;
    background: color-mix(in srgb, var(--surface) 76%, transparent);
    color: var(--accent-strong);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  @media (max-width: 47.99rem) {
    .brand-header-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.35rem 1rem;
      padding-block: 0.55rem;
    }

    .header-actions {
      display: contents;
    }

    .header-actions nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .language-link {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .nav-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.05rem 0.35rem;
      width: 100%;
    }

    .nav-list a {
      min-height: 2rem;
      justify-content: center;
      padding-inline: 0.1rem;
      font-size: 0.69rem;
      text-align: center;
    }
  }
</style>
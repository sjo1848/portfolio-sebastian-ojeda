---
import type { ProjectQuickScanCopy } from '../data/projectQuickScans';
import GitHubMarkLink from './GitHubMarkLink.astro';

interface Props {
  id: string;
  copy: ProjectQuickScanCopy;
  repository: string | null;
  proofHref: string | null;
  proofAction: string | null;
  proofLimitations: string;
  caseStudyTarget: string;
}

const { id, copy, repository, proofHref, proofAction, proofLimitations, caseStudyTarget } = Astro.props;
---

<section id={id} class="case-quick-scan section" aria-labelledby={`${id}-title`}>
  <div class="container case-quick-scan-inner">
    <header class="case-quick-scan-heading">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id={`${id}-title`}>{copy.title}</h2>
    </header>
    <dl class="case-quick-scan-grid">
      <div>
        <dt>{copy.problemLabel}</dt>
        <dd>{copy.problem}</dd>
      </div>
      <div>
        <dt>{copy.systemLabel}</dt>
        <dd>{copy.system}</dd>
      </div>
      <div>
        <dt>{copy.evidenceLabel}</dt>
        <dd>{copy.evidence}</dd>
      </div>
      <div>
        <dt>{copy.limitationsLabel}</dt>
        <dd>{proofLimitations}</dd>
      </div>
    </dl>
    <div class="case-quick-scan-links">
      {repository && <GitHubMarkLink href={repository} label={copy.repositoryLabel} rel="noopener noreferrer" class="quick-scan-repository-mark" />}
      {proofHref && proofAction && <a class="button button-secondary case-proof-link" href={proofHref}>{proofAction}</a>}
      <a class="button button-primary" href={caseStudyTarget}>{copy.continue}</a>
    </div>
  </div>
</section>

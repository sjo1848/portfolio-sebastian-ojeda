---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { capabilityGroups, processSteps, site } from '../data/site';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero section">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Backend-focused full-stack developer</p>
        <h1>{site.title}</h1>
        <p class="hero-copy">{site.description}</p>
        <p class="hero-context">
          Trabajo desde el análisis del dominio hasta la implementación, las pruebas y el despliegue.
          Mi experiencia con sistemas empresariales e integraciones me ayuda a convertir procesos reales en software confiable.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projects">Ver proyectos</a>
          <a class="button button-secondary" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
      <aside class="hero-proof" aria-label="Enfoque de trabajo">
        <p>Dominio</p><span aria-hidden="true">→</span>
        <p>Arquitectura</p><span aria-hidden="true">→</span>
        <p>Implementación</p><span aria-hidden="true">→</span>
        <p>QA</p><span aria-hidden="true">→</span>
        <p>Operación</p>
      </aside>
    </div>
  </section>

  <section id="projects" class="section section-surface" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Evidencia de trabajo</p>
        <h2 id="projects-title">Proyectos destacados</h2>
        <p>Tres soluciones con objetivos distintos: profundidad técnica, operación móvil y entrega comercial.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="process" class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Proceso</p>
        <h2 id="process-title">Cómo trabajo</h2>
      </div>
      <ol class="process-grid">
        {processSteps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-night" aria-labelledby="capabilities-title">
    <div class="container split-grid">
      <div>
        <p class="eyebrow eyebrow-light">Capacidades</p>
        <h2 id="capabilities-title">Tecnología organizada alrededor del problema</h2>
      </div>
      <div class="capability-grid">
        {capabilityGroups.map((group) => (
          <article><h3>{group.title}</h3><p>{group.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container split-grid">
      <div class="section-heading">
        <p class="eyebrow">Contexto operativo</p>
        <h2 id="experience-title">Sistemas empresariales, integraciones y procesos reales</h2>
      </div>
      <div class="reading-column">
        <p>
          Mi experiencia incluye administración SAP, integraciones SAP PI/PO y trabajo con procesos operativos.
          Ese contexto influye en cómo diseño software: considero actores, excepciones, trazabilidad, continuidad y calidad de datos desde el comienzo.
        </p>
        <p>
          Me interesa construir sistemas de gestión, aplicaciones móviles y herramientas internas donde la arquitectura técnica esté conectada con una necesidad concreta.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="section section-surface" aria-labelledby="contact-title">
    <div class="container contact-panel">
      <div>
        <p class="eyebrow">Contacto</p>
        <h2 id="contact-title">Busco oportunidades en backend, full stack y software operativo</h2>
        <p>{site.location}. Los enlaces de email, LinkedIn y CV se activarán cuando los datos públicos sean confirmados.</p>
      </div>
      <a class="button button-primary" href={site.github} target="_blank" rel="noreferrer">Ver GitHub</a>
    </div>
  </section>
</BaseLayout>

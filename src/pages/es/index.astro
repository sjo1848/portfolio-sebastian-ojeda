---
import { getCollection } from 'astro:content';
import HomePage from '../../components/HomePage.astro';
import { primaryStorySlugs, secondaryCaseSlugs } from '../../data/portfolioStories';

const allProjects = await getCollection('projects');
const bySlug = new Map(allProjects.map((project) => [project.data.slug, project]));
const primaryProjects = primaryStorySlugs.flatMap((slug) => {
  const project = bySlug.get(slug);
  return project ? [project] : [];
});
const secondaryProjects = secondaryCaseSlugs.flatMap((slug) => {
  const project = bySlug.get(slug);
  return project ? [project] : [];
});
---

<HomePage lang="es" primaryProjects={primaryProjects} secondaryProjects={secondaryProjects} />

---
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import '../styles/branding.css';
import '../styles/selected-work.css';
import {
  copyByLanguage,
  siteByLanguage,
  type Language,
} from '../data/site';
import {
  defaultLanguage,
  getAlternatePath,
} from '../data/routing';

interface Props {
  lang?: Language;
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang = defaultLanguage,
  title,
  description,
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const site = siteByLanguage[lang];
const copy = copyByLanguage[lang];
const resolvedTitle = title ?? site.title;
const resolvedDescription = description ?? site.description;
const pageTitle = resolvedTitle === site.title
  ? lang === 'es'
    ? `${site.name} — Full-Stack Developer`
    : `${site.name} — Full-Stack Developer`
  : `${resolvedTitle} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const alternate = new URL(getAlternatePath(Astro.url.pathname, lang), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={site.languageTag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      lang={lang}
      title={pageTitle}
      description={resolvedDescription}
      canonical={canonical}
      alternate={alternate}
      type={ogType}
      noindex={noindex}
      structuredData={structuredData}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <SiteHeader lang={lang} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>{site.name} · {site.location}</p>
        <a href={site.github} rel="me">GitHub</a>
      </div>
    </footer>
  </body>
</html>

{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/es/",
        "http://localhost/projects/hms-cloudflare/",
        "http://localhost/es/projects/hms-cloudflare/",
        "http://localhost/projects/alquileres-uspa/",
        "http://localhost/es/projects/alquileres-uspa/"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./artifacts/lighthouse/supported-build-toolchain-increment-5-release-candidate"
    }
  }
}
